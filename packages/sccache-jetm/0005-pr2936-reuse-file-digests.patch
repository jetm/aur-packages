+impl HashCacheStamp {
+    fn for_file(file: &File) -> std::io::Result<Self> {
+        let metadata = file.metadata()?;
+        if !metadata.is_file() {
+            return Err(std::io::Error::other("Not a regular file"));
+        }
+        #[cfg(not(windows))]
+        let ctime = metadata.ctime_or_creation()?;
+        #[cfg(windows)]
