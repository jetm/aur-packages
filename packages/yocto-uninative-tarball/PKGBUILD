# Maintainer: Javier Tia <floss@jetm.me>

pkgname=yocto-uninative-tarball
# <master uninative>_<lts uninative>+<arch glibc>
pkgver=5.1_5.1+2.44
pkgrel=1
pkgdesc='Yocto Project uninative libc tarball mirrored for offline bitbake builds'
arch=('x86_64')
url='https://downloads.yoctoproject.org/releases/uninative/'
# Enumerated from the payload: glibc and libxcrypt (LGPL-2.1-or-later),
# libstdc++ and libgcc_s (GPL-3.0-or-later WITH GCC-exception), libtirpc
# (BSD-3-Clause) and relocate_sdk.py (GPL-2.0-only). The tarball ships no
# license files of its own.
license=('LGPL-2.1-or-later' 'GPL-3.0-or-later WITH GCC-exception'
         'BSD-3-Clause' 'GPL-2.0-only')
makedepends=('curl')

# Refuse to raise the ceiling when the host glibc runs more than this many
# minor releases ahead of the mirrored payload's.
_max_glibc_skew=1

# The mirrored set is a function of pkgver alone. oe-core master and the LTS
# branch adopt a uninative release at different times, so both declared
# versions are carried in pkgver and both payloads are mirrored while they
# disagree. Nothing here may be hand-maintained: update-version.sh rewrites
# pkgver and nothing else.
_uninative_ver=${pkgver%%_*}
_lts_ver=${pkgver#*_}
_lts_ver=${_lts_ver%+*}
_uninative_vers=("$_uninative_ver")
if [[ $_lts_ver != "$_uninative_ver" ]]; then
  _uninative_vers+=("$_lts_ver")
fi

_mirror=/usr/share/yocto-uninative/mirror
_baseurl=https://downloads.yoctoproject.org/releases/uninative

source=()
for _v in "${_uninative_vers[@]}"; do
  source+=("${_baseurl}/${_v}/x86_64-nativesdk-libc-${_v}.tar.xz")
done
unset _v
sha256sums=('2b63a078c26535e0786e87f81ae69509df30f4dce40693004c527bd5e4ab2b85')

# Every uninative tarball carries x86_64-linux/lib/ld-linux-x86-64.so.2 at the
# same relative path, so makepkg's own extraction of a second payload would
# silently overwrite the first and the probe below would read whichever landed
# last. build() extracts each payload into its own tree instead.
noextract=("${source[@]##*/}")

# Extract a single MAJOR.MINOR from a glibc version banner. The two sources
# print different shapes - the loader ends with a full stop ("stable release
# version 2.44."), ldd does not ("ldd (GNU libc) 2.44") - so a shared
# positional field-pick would yield "2.44." and die in the arithmetic below.
# Match the shape instead, and refuse anything that is not exactly one
# MAJOR.MINOR.
_glibc_version_of() {
  local _label=$1 _raw=$2 _ver

  _ver=$(printf '%s\n' "$_raw" | head -1 | grep -Po '\d+\.\d+(?=\.?\s*$)') || _ver=
  if [[ -z $_ver || $_ver == *$'\n'* ]]; then
    error "%s: expected exactly one MAJOR.MINOR glibc version, got %s from: %s" \
      "$_label" "${_ver:-<no match>}" "${_raw:-<no output>}"
    return 1
  fi
  printf '%s' "$_ver"
}

build() {
  local _v _dir _tarball _loader _raw _ver _maj _min
  local _host_glibc _host_maj _host_min _tb_maj _tb_min

  # Not local: task 3.1 emits this as UNINATIVE_TARBALL_GLIBC.
  _tarball_glibc=

  for _v in "${_uninative_vers[@]}"; do
    _tarball="x86_64-nativesdk-libc-${_v}.tar.xz"
    _dir="$srcdir/x-${_v}"
    rm -rf "$_dir"
    mkdir -p "$_dir"
    bsdtar -xf "$srcdir/$_tarball" -C "$_dir"

    # Probe every mirrored payload, not just the primary one. Which payload a
    # consumer resolves is decided by their oe-core's UNINATIVE_CHECKSUM, so
    # the guard has to hold for the weakest payload in the set.
    _loader="$_dir/x86_64-linux/lib/ld-linux-x86-64.so.2"
    _raw=$(LC_ALL=C "$_loader" --version 2>&1) || true
    _ver=$(_glibc_version_of "$_tarball loader" "$_raw") || return 1

    _maj=${_ver%%.*}
    _min=${_ver##*.}
    if [[ -z $_tarball_glibc ]] ||
      ((_maj < _tb_maj || (_maj == _tb_maj && _min < _tb_min))); then
      _tarball_glibc=$_ver
      _tb_maj=$_maj
      _tb_min=$_min
    fi
  done

  _raw=$(LC_ALL=C ldd --version 2>&1) || true
  _host_glibc=$(_glibc_version_of 'ldd --version' "$_raw") || return 1
  _host_maj=${_host_glibc%%.*}
  _host_min=${_host_glibc##*.}

  msg2 "mirrored payload glibc %s (lowest of %s), host glibc %s" \
    "$_tarball_glibc" "${_uninative_vers[*]}" "$_host_glibc"

  if ((_host_maj != _tb_maj)) ||
    ((_host_min - _tb_min > _max_glibc_skew)); then
    if [[ -n ${CI:-} ]]; then
      warning "host glibc %s runs ahead of the mirrored payload's %s by more than _max_glibc_skew=%s; raise _max_glibc_skew in the PKGBUILD once the payload catches up" \
        "$_host_glibc" "$_tarball_glibc" "$_max_glibc_skew"
    else
      error "host glibc %s runs ahead of the mirrored payload's %s by more than _max_glibc_skew=%s; raise _max_glibc_skew in the PKGBUILD once the skew is known to be safe" \
        "$_host_glibc" "$_tarball_glibc" "$_max_glibc_skew"
      return 1
    fi
  fi
}

package() {
  local _v _tarball _sha

  for _v in "${_uninative_vers[@]}"; do
    _tarball="x86_64-nativesdk-libc-${_v}.tar.xz"
    # Computed here, not in build(): makepkg re-execs under fakeroot and
    # re-sources this file, discarding anything build() assigned.
    _sha=$(sha256sum "$srcdir/$_tarball" | cut -d' ' -f1)

    # Two premirror mechanisms resolve to two different shapes. The class
    # appends a checksum-addressed mapping; the fragment's own entry resolves
    # to the flat basename. Install both so neither is load-bearing alone.
    install -Dm644 "$srcdir/$_tarball" \
      "${pkgdir}${_mirror}/uninative/${_sha}/${_tarball}"
    install -Dm644 "$srcdir/$_tarball" \
      "${pkgdir}${_mirror}/${_tarball}"
  done
}

# vim:set ts=2 sw=2 et:
