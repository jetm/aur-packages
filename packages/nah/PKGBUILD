# Maintainer: Javier Tia <floss@jetm.me>
_pkgauthor=manuelschipper
pkgname=nah
pkgver=1.0.0
pkgrel=1
pkgdesc='Safety guard that blocks catastrophic coding-agent tool calls before they run'
arch=('x86_64' 'aarch64')
url="https://github.com/${_pkgauthor}/${pkgname}"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('rust')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('609da8e0c5ed1d3fe2531ef2a4503db3a5a8915198b3f0ecbf3c1cfede1e4e63')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # rust-toolchain.toml pins 1.91.1. Under rustup that pin is honoured and would
  # fetch a second toolchain to build a package the system compiler already
  # satisfies, since 1.91.1 is the crate's minimum rather than an exact
  # requirement.
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Cargo.lock is committed upstream; --locked keeps the build reproducible.
  cargo build --release --locked --package nah-cli
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 target/release/nah "${pkgdir}/usr/bin/nah"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

# vim:set ft=PKGBUILD ts=2 sw=2 et:
